{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "channel": "internal" },
    "internal": {
      "distribution": "internal",
      "channel": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": { "BACKEND_URL": "https://one-local-server.vercel.app" }
    },
    "pilot": {
      "distribution": "internal",
      "channel": "pilot",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": { "BACKEND_URL": "https://one-local-server.vercel.app" }
    },
    "production": {
      "channel": "stable",
      "autoIncrement": true,
      "environment": "production",
      "env": { "BACKEND_URL": "https://one-local-server.vercel.app" }
    }
  },
  "submit": { "production": {} }
}
